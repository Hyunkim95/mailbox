{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-core/types/**/*.ts",
    ".next-core/dev/types/**/*.ts",
    "artifacts/demo/next-review/types/**/*.ts",
    "artifacts/demo/next-review/dev/types/**/*.ts",
    "artifacts/staged-review/completion-build/types/**/*.ts",
    "artifacts/staged-review/completion-build/dev/types/**/*.ts",
    "artifacts/demo/connected-build/types/**/*.ts",
    "artifacts/demo/connected-build/dev/types/**/*.ts",
    "artifacts/dashboard/build/types/**/*.ts",
    "artifacts/dashboard/build/dev/types/**/*.ts",
    "artifacts/dashboard/final-build/types/**/*.ts",
    "artifacts/dashboard/final-build/dev/types/**/*.ts",
    "artifacts/pigeon/build/types/**/*.ts",
    "artifacts/pigeon/build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist"
  ]
}
