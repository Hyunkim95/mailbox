# Fill the service credentials below. Never commit .env.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MERCHANT_ID=your_paypal_sandbox_business_merchant_id
# Register the sandbox capture webhook after deployment; see DEPLOYMENT.md.
PAYPAL_WEBHOOK_ID=
AGENTMAIL_API_KEY=your_agentmail_api_key
# Register the receiving webhook and copy its signing secret; see DEPLOYMENT.md.
AGENTMAIL_WEBHOOK_SECRET=
# Select openai or anthropic. Blank auto-selects Claude only when just its key is set.
AI_PROVIDER=
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=
# Needed for the hosted demo; local development works without these.
RENDER_API_KEY=your_render_api_key
RENDER_OWNER_ID=your_render_workspace_or_owner_id

# Local settings
APP_URL=http://127.0.0.1:3000
MOCK_MERCHANT_URL=http://127.0.0.1:3000
MOCK_MERCHANT_PORT=3011
MOCK_DATABASE_PATH=./data/merchant.sqlite
MOCK_CUSTOMER_ID=maya

# Private application secrets. Generated in .env; placeholders in this example.
APP_SESSION_SECRET=generate_a_long_random_secret
MOCK_MERCHANT_TOKEN=generate_a_long_random_secret
MOCK_ADMIN_TOKEN=generate_a_different_long_random_secret
DEMO_ACCESS_KEY=choose_a_demo_login_key

# Product discovery and AG Studio dashboard integration
CHANNEL3_API_KEY=your_channel3_api_key
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
